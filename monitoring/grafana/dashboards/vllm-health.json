{
 "uid": "vllm-health",
 "title": "vLLM health",
 "tags": [
  "vllm"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Engine state",
   "description": "STALLED = a request is running but no token was generated in the last minute (the 19 Nov freeze). The watchdog restarts vLLM after 90 s of this.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "generating / idle",
         "color": "green"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 1,
        "to": 1000000000.0,
        "result": {
         "text": "STALLED",
         "color": "red"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_max((max(vllm:num_requests_running) > 0 and on() sum(rate(vllm:generation_tokens_total[1m])) == 0) or on() vector(0), 1)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "vLLM reachable",
   "description": "0 while vLLM loads or restarts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "up",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"vllm\"}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Restarts (24 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "changes(process_start_time_seconds{job=\"vllm\"}[24h])"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Generation now",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "tok/s",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[1m]))"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Tokens per second",
   "description": "A freeze shows as 'generated' dropping to 0 while a request is still running.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "tok/s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
     "legendFormat": "generated"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:prompt_tokens_total[1m]))",
     "legendFormat": "prompt (prefill)"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Requests",
   "description": "MAX_NUM_SEQS is 2, so at most 2 run; the rest wait.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_running)",
     "legendFormat": "running"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_waiting)",
     "legendFormat": "waiting"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "KV cache used",
   "description": "The earlier hangs (Oct, 13 Nov) came when this hit ~98% and a request was preempted.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(vllm:kv_cache_usage_perc)",
     "legendFormat": "KV cache"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Preemptions",
   "description": "A request pushed out because the KV cache ran out.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 80,
      "drawStyle": "bars",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(vllm:num_preemptions_total[1m]))",
     "legendFormat": "per minute"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Restarts",
   "description": "Each bar is a vLLM (re)start: the watchdog, a crash or a manual restart.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 80,
      "drawStyle": "bars",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "changes(process_start_time_seconds{job=\"vllm\"}[1m])",
     "legendFormat": "vLLM started"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "GPU utilisation",
   "description": "100% with LOW power and no tokens = a stuck kernel (19 Nov: 113 W).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(nvidia_smi_utilization_gpu_ratio)",
     "legendFormat": "GPU busy"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "GPU power",
   "description": "~400 W while generating.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "watt"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(nvidia_smi_power_draw_watts)",
     "legendFormat": "power"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "GPU memory and temperature",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(nvidia_smi_memory_used_bytes)",
     "legendFormat": "memory used"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Time per output token (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by(le)(rate(vllm:inter_token_latency_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by(le)(rate(vllm:inter_token_latency_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Time to first token (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "drawStyle": "line",
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by(le)(rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by(le)(rate(vllm:time_to_first_token_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  }
 ],
 "description": "Is the vLLM server generating, stuck, or restarting? Built after the 19 Nov 2026 freeze."
}